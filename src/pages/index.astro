---
import About from "../components/About.astro";
import CTABanner from "../components/CTABanner.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Sectores from "../components/Sectores.astro";
import Servicios from "../components/Servicios.astro";
import Tienda from "../components/Tienda.astro";
import WhatsAppFab from "../components/WhatsAppFab.astro";
import Base from "../layouts/Base.astro";
---

<Base>
  <Header client:load />
  <main id="main-content">
    <Hero />
    <Marquee />
    <Servicios />
    <Sectores />
    <!-- Ocultado hasta tener más imágenes de personalización -->
    <!-- <Personalizacion client:visible /> -->
    <About />
    <Tienda />
    <!-- Ocultado hasta tener más claro el formato de las preguntas -->
    <!-- <FAQ client:visible /> -->
    <CTABanner />
  </main>
  <Footer />
  <WhatsAppFab />
</Base>
