---
interface Props {
  width?: number;
  height?: number;
  color?: string;
}
const { width = 14, height = 200, color = 'currentColor' } = Astro.props;
---
<svg
  width={width}
  height={height}
  viewBox="0 0 14 200"
  class="needle-svg"
  style="display:block"
>
  <ellipse cx="7" cy="6" rx="3.4" ry="4.4" fill="none" stroke={color} stroke-width="1.5" />
  <path d={`M 8.4 10 L 9 196 L 7 198 L 5 196 L 5.6 10 Z`} fill={color} />
</svg>
