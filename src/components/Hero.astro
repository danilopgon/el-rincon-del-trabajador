---
import { Image } from "astro:assets";
import escaparateImg from "../../public/escaparate-el-rincon-del-trabajador.webp";
import { CONTACT } from "../lib/contact";
import NeedleSVG from "./icons/NeedleSVG.astro";
---

<section class="hero section">
  <div class="wrap hero__container">
    <div class="heroA__grid">
      <div>
        <span class="eyebrow">Tarancón · Cuenca</span>
        <h1 class="heroA__title" style="margin-top:28px">
          Te vestimos<br /><em>para tu trabajo.</em>
        </h1>
        <p class="heroA__sub">
          Ropa laboral, EPI certificado y personalización con bordado o DTF desde una sola unidad.
          Asesoramiento de toda la vida, en la tienda o por WhatsApp.
        </p>
        <div class="heroA__actions">
          <a href="#contacto" class="btn btn--primary btn--lg">
            Pedir presupuesto
            <svg
              aria-hidden="true"
              class="icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <a
            href={CONTACT.whatsapp}
            class="btn btn--ghost btn--lg"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg aria-hidden="true" class="icon" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.5A10 10 0 1 0 12 2zm5.4 14.3c-.2.6-1.2 1.1-1.7 1.2-.5.1-1 .2-3.2-.7-2.7-1.1-4.4-3.9-4.5-4.1-.1-.2-1.1-1.4-1.1-2.7 0-1.3.7-1.9 1-2.2.3-.3.6-.3.8-.3h.6c.2 0 .5 0 .7.5l1 2.3c.1.2.1.4 0 .5l-.4.5-.5.5c-.1.1-.3.3-.1.6.2.3.9 1.5 2 2.4 1.3 1.2 2.5 1.5 2.8 1.7.3.1.5.1.7-.1l.8-.9c.2-.2.4-.2.7-.1l2.2 1c.3.2.4.2.5.4.1.2.1 1-.2 1.5z"
              ></path>
            </svg>
            Hablamos por WhatsApp
            <span class="sr-only"> (abre en nueva pestaña)</span>
          </a>
        </div>
        <div class="heroA__meta">
          <div class="heroA__meta-item">
            <strong>+15</strong><span>años en el sector</span>
          </div>
          <div class="heroA__meta-item">
            <strong>1 ud.</strong><span>mínimo para DTF</span>
          </div>
          <div class="heroA__meta-item">
            <strong>Tarancón</strong><span>tienda física en Cuenca</span>
          </div>
        </div>
      </div>

      <div class="heroA__media">
        <Image
          src={escaparateImg}
          alt="Escaparate de El Rincón del Trabajador"
          width={800}
          height={1000}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          widths={[400, 600, 800]}
          sizes="(max-width: 800px) 100vw, 45vw"
          quality={85}
        />
        <div style="position:absolute;top:-24px;right:32px;transform:rotate(8deg);opacity:0.65">
          <NeedleSVG width={18} height={150} color="var(--color-navy)" />
        </div>
      </div>
    </div>
  </div>
</section>
