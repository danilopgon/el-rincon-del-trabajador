---
const services = [
  {
    n: "01",
    title: "Ropa de trabajo",
    desc: "Monos, pantalones, chaquetillas y prendas técnicas para cualquier sector.",
    img: "/ropa-de-trabajo.webp",
    list: [
      "Industria y obra",
      "Hostelería y cocina",
      "Sanitario y limpieza",
      "Logística y reparto",
    ],
  },
  {
    n: "02",
    title: "EPI certificado",
    desc: "Calzado de seguridad, guantes, gafas, auriculares y arneses con marcado CE.",
    img: "/epis.webp",
    list: [
      "Calzado S1P · S3",
      "Protección manos",
      "Protección ocular y auditiva",
      "Anticaídas y altura",
    ],
  },
  {
    n: "03",
    title: "Bordado y DTF",
    desc: "Personalizamos con tu logo desde una sola prenda. Pruebas digitales antes de coser.",
    img: "/bordado.webp",
    list: ["Bordado profesional", "DTF a todo color", "Vinilo textil", "Etiquetado y tallaje"],
  },
  {
    n: "04",
    title: "Asesoramiento",
    desc: "Te ayudamos a elegir según normativa, sector y presupuesto. En persona o por WhatsApp.",
    img: "/tienda-atencion.webp",
    list: [
      "Análisis de necesidades",
      "Tallaje en tienda",
      "Renovación de uniformes",
      "Postventa cercana",
    ],
  },
];
---

<section id="servicios" class="section">
  <div class="wrap">
    <div class="svc__head" data-reveal>
      <div>
        <span class="eyebrow">Qué hacemos</span>
        <h2 style="margin-top:16px">Cuatro servicios,<br />una misma tienda.</h2>
      </div>
      <p class="lead">
        Todo lo que tu equipo necesita para un semana de trabajo: prendas, protección, identidad
        bordada y alguien al teléfono cuando hace falta resolver algo.
      </p>
    </div>
    <div class="svc__grid" data-reveal-stagger>
      {
        services.map((svc) => (
          <article class="svc__card">
            <div class="svc__card-img">
              <img src={svc.img} alt="" loading="lazy" decoding="async" />
            </div>
            <div class="svc__card-num">{svc.n} / 04</div>
            <h3>{svc.title}</h3>
            <p>{svc.desc}</p>
            <ul class="svc__card-list">
              {svc.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
