---
import Icon from "./icons/Icon.astro";
import { CONTACT } from "../lib/contact";
---

<section id="contacto" class="cta-banner">
  <div class="wrap cta-banner__inner" data-reveal>
    <div>
      <span class="eyebrow" style="color:var(--color-gold)">Empezar un pedido</span>
      <h2 class="cta-banner__title" style="margin-top:16px">
        ¿Listos para vestir<br />a vuestro <span class="gold">equipo?</span>
      </h2>
      <p class="cta-banner__sub">
        Cuéntanos qué sector, cuántas personas y si necesitáis bordado. En menos de 24 horas tienes
        presupuesto y muestrario en pantalla.
      </p>
    </div>
    <div class="cta-banner__actions">
      <a
        href={CONTACT.whatsappCta}
        class="btn btn--gold btn--lg"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="whatsapp" width="18" height="18" class="icon" />
        Presupuesto por WhatsApp
      </a>
      <a
        href={`tel:${CONTACT.phone}`}
        class="btn btn--ghost btn--lg"
        style="color:var(--color-cream);border-color:rgba(247,239,217,0.55)"
      >
        <Icon name="phone" width="18" height="18" class="icon" />
        {CONTACT.phoneDisplay}
      </a>
      <a
        href={`mailto:${CONTACT.email}`}
        class="btn btn--ghost btn--lg"
        style="color:var(--color-cream);border-color:rgba(247,239,217,0.55)"
      >
        <Icon name="mail" width="18" height="18" class="icon" />
        Escribir email
      </a>
    </div>
  </div>
  <div class="cta-banner__corner"></div>
</section>
