---
import Icon from "./icons/Icon.astro";
import { CONTACT } from "../lib/contact";
---

<section id="contacto" class="cta-banner">
  <div class="wrap cta-banner__inner" data-reveal>
    <div>
      <h2 class="cta-banner__title">Empezar<br />un pedido</h2>
      <p class="cta-banner__sub">
        Cuéntanos qué sector, cuántas personas y si necesitas personalización. Respondemos rápido
        por WhatsApp o email, y también atendemos en tienda.
      </p>
    </div>
    <div class="cta-banner__actions">
      <a
        href={CONTACT.whatsappCta}
        class="btn btn--gold btn--lg"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="whatsapp" width="18" height="18" class="icon" />
        Presupuesto por WhatsApp
        <span class="sr-only"> (abre en nueva pestaña)</span>
      </a>
      <a href={`tel:${CONTACT.phone}`} class="btn btn--ghost btn--on-dark btn--lg">
        <Icon name="phone" width="18" height="18" class="icon" />
        {CONTACT.phoneDisplay}
      </a>
      <a href={`mailto:${CONTACT.email}`} class="btn btn--ghost btn--on-dark btn--lg">
        <Icon name="mail" width="18" height="18" class="icon" />
        Escribir email
      </a>
    </div>
  </div>
  <div class="cta-banner__corner"></div>
</section>
