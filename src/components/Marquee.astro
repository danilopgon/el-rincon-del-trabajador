---
const items = [
  "EPI certificado CE",
  "Asesoramiento en tienda",
  "Entregas 48–72 h en Cuenca",
  "15 años de experiencia",
  "Personalización con bordado o DTF",
  "Primeras marcas del sector",
];
const doubled = [...items, ...items];
---

<div class="marquee">
  <div class="marquee__track">
    {
      doubled.map((item) => (
        <span class="marquee__item">
          <span class="dot" />
          {item}
        </span>
      ))
    }
  </div>
</div>
