---
import Icon from "./icons/Icon.astro";

const sectors = [
  { icon: "sIndustry", title: "Industria", meta: "Fabricación y talleres" },
  { icon: "sHorec", title: "Hostelería", meta: "Cocina y sala" },
  { icon: "sHealth", title: "Sanitario", meta: "Clínicas y residencias" },
  { icon: "sLogi", title: "Logística", meta: "Almacén y reparto" },
  { icon: "sConstr", title: "Construcción", meta: "Obra y reformas" },
  { icon: "sShop", title: "Comercio", meta: "Tiendas y oficinas" },
];
---

<section id="sectores" class="section section--paper">
  <div class="wrap">
    <div class="svc__head" data-reveal>
      <h2>Cada sector,<br />su propia prenda.</h2>
      <p class="lead">
        En El Rincón del Trabajador sabemos que cada puesto de trabajo tiene necesidades
        específicas. Por eso ofrecemos ropa adaptada a cada sector, con tejidos y acabados
        específicos para cada tipo de uso.
      </p>
    </div>
    <div class="sect__grid" data-reveal>
      {
        sectors.map((s) => (
          <a href="#contacto" class="sect__cell">
            <Icon name={s.icon} width="36" height="36" class="sect__cell-icon" />
            <div class="sect__cell-arrow">
              <Icon name="arrowUR" width="20" height="20" />
            </div>
            <span class="sect__cell-meta">{s.meta}</span>
            <span class="sect__cell-title">{s.title}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
