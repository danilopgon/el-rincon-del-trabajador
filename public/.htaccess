# ─── Security Headers ────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # Fuerza HTTPS en visitas siguientes (1 año).
    # includeSubDomains omitido: en hosting compartido puede haber subdominios
    # sin HTTPS (webmail, panel). Añadirlo solo si todos los subdominios son HTTPS.
    Header always set Strict-Transport-Security "max-age=31536000"

    # Impide que el navegador infiera un MIME type distinto al declarado
    Header always set X-Content-Type-Options "nosniff"

    # Bloquea que el sitio se embeba en iframes de terceros (anti-clickjacking)
    Header always set X-Frame-Options "DENY"

    # Solo envía el origen en requests cross-origin (sin path ni query)
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Deshabilita APIs sensibles que este sitio no usa
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # Content Security Policy
    # 'unsafe-inline' es necesario para los scripts inline de Astro SSG (JSON-LD,
    # hidratación de islands). En SSR se podría sustituir por nonces.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src https://www.google.com/maps/; frame-ancestors 'none'; font-src 'self'; connect-src 'self'; form-action 'self'; object-src 'none'; base-uri 'self'"
</IfModule>

# ─── Cache — assets con hash de contenido (Vite) ─────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML sin caché — siempre fresco
    ExpiresByType text/html "access plus 0 seconds"

    # Assets con hash de Vite — inmutables
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType font/woff2               "access plus 1 year"
    ExpiresByType image/png                "access plus 1 year"
    ExpiresByType image/webp               "access plus 1 year"
    ExpiresByType image/svg+xml            "access plus 1 year"
</IfModule>
